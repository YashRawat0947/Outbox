PORT=4000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/inbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

JWT_SECRET=secret-key
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must be HTTPS (use ngrok in dev) and registered in your Slack app
SLACK_REDIRECT_URI=https://<your-ngrok>.ngrok.app/api/slack/callback

# Number of Ethereal sender accounts auto-created on first boot
SENDER_ACCOUNTS=3
# Parallel jobs per worker process
WORKER_CONCURRENCY=5
# Min gap between two sends from the SAME sender account
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Hourly cap PER SENDER ACCOUNT (default; a request may override it)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_ATTEMPTS=3
